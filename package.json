{
  "name": "yetenek-yonetimi-butce-takip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env backend/server.mjs --dev",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "setup": "node --env-file-if-exists=.env backend/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "demo:reset": "node --env-file-if-exists=.env backend/setup.mjs --reset-demo",
    "test:ui": "npm run build && node scripts/ui-check.mjs",
    "format": "prettier --write frontend/src frontend/vite.config.ts backend/*.mjs shared/*.mjs scripts/*.mjs scripts/mssql/*.mjs tests/*.mjs",
    "db:export:mssql": "node --env-file-if-exists=.env scripts/export-mssql.mjs",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "5.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
