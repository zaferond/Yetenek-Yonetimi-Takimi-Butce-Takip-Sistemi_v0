HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
DB_PATH=./data/budget.sqlite
NODE_ENV=development
# Yalnızca ilk kurulumda kullanılır; sonra bu satırları kaldırabilirsiniz.
ADMIN_USERNAME=demo
# ADMIN_PASSWORD=en-az-12-karakterlik-kendi-parolaniz
SEED_DEMO=true
# Şirket ortamında HTTPS reverse proxy ile true yapılmalıdır.
COOKIE_SECURE=false
